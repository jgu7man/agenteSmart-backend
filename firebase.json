{
  "functions": {
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 1000
    }
  },
  "hosting": {
    "site": "api-agentesmart",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "public": "functions/lib",
    "rewrites": [ 
      { 
        "source": "/dialogflow{,/**}", 
        "function": "dialogflow" 
      },
      { 
        "source": "/messenger{,/**}", 
        "function": "messenger"
      } 
    ]
  }
}
