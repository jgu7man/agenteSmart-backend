{
  "name": "functions",
  "scripts": {
    "lint": "tslint --project tsconfig.json",
    "build": "tsc",
    "dev": "tsc-watch --onSuccess \"node --inspect lib/index.js\"",
    "hotReload": "npm run build && firebase emulators:start --inspect-functions --only firestore",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "debug": "nodemon -e ts --exec \"npm run hotReload\""
  },
  "engines": {
    "node": "10"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/dialogflow": "^2.0.0",
    "@google-cloud/resource": "^1.2.1",
    "@hapi/joi": "^17.1.1",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dialogflow": "^4.0.3",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "firebase-admin": "^9.2.0",
    "firebase-functions": "^3.6.1",
    "google-auth-library": "^6.0.0",
    "googleapis": "^51.0.0",
    "uuid": "^8.3.0",
    "when": "^3.7.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.6",
    "@types/express": "^4.17.6",
    "@types/uuid": "^8.0.0",
    "@types/when": "^2.4.33",
    "firebase-functions-test": "^0.2.0",
    "nodemon": "^2.0.6",
    "tsc-watch": "^4.2.9",
    "tslint": "^5.12.0",
    "typescript": "^3.8.0"
  },
  "private": true
}
