{
  "compilerOptions": {
    "module": "commonjs",
    "strictNullChecks": false,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "resolveJsonModule" :true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "esModuleInterop": true,
    "allowJs": true,
    "lib": [
      "esnext.asynciterable"
    ]
  },
  "compileOnSave": true,
  "rootDir": "src/"
}
